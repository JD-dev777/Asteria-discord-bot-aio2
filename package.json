{
  "name": "asteria-discord",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Asteria: a modular community, moderation and security Discord bot",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "deploy": "tsx src/deploy.ts",
    "build": "tsc",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "database": "tsx src/database.ts",
    "format": "prettier --write src test docs README.md package.json tsconfig*.json .github",
    "format:check": "prettier --check src test docs README.md package.json tsconfig*.json .github"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "@snazzah/davey": "^0.1.6",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.3.0",
    "opusscript": "^0.1.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
