DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Register instantly in a test guild. Omit for global commands.
DISCORD_GUILD_ID=
DATABASE_PATH=./data/asteria.sqlite
MESSAGE_CONTENT_ENABLED=false
# Enable only when invite tracking is wanted (requires Manage Server).
INVITE_TRACKING_ENABLED=false
# Only these Discord users can run developer or premium administration.
OPERATOR_IDS=
HEALTH_HOST=127.0.0.1
HEALTH_PORT=3000
# Protects /api/guilds/:id/stats. Leave blank to disable this endpoint.
API_TOKEN=
# Optional Stripe billing: set all three to enable signed webhook processing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Override only for a local test Stripe provider.
STRIPE_API_BASE_URL=https://api.stripe.com
BILLING_RETURN_URL=https://example.com/billing
# Operator curated JSON map of track names to HTTPS audio URLs. Never accepts user URLs.
MUSIC_TRACKS={}
# Operator curated JSON map of feed names to HTTPS RSS/Atom URLs.
SOCIAL_FEEDS={}
